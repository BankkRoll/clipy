# Dependencies
node_modules/
.pnpm-store/

# Build outputs
dist/
dist-ssr/
*.local

# Stale Electron-era build artifacts (not used by the Tauri build)
.vite/
out/

# Local agent/skills scratch
.agents/

# Tauri
src-tauri/target/
src-tauri/WixTools/
src-tauri/binaries/ffmpeg*
src-tauri/binaries/yt-dlp*

# IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
.fleet/
*.sublime-workspace
*.sublime-project

# Claude Code
.claude/

# OS files
.DS_Store
Thumbs.db
desktop.ini
ehthumbs.db
# NOTE: the old macOS `Icon?` rule was removed — on Windows git matches
# case-insensitively, so `Icon?` swallowed the real app icons (icon.ico,
# icon.png, 32x32.png ...). App icons are REQUIRED by `tauri build`.
!src-tauri/icons/
!src-tauri/icons/**

# Environment files
.env
.env.local
.env.*.local
.env.development
.env.production

# Logs
logs/
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*

# Test coverage
coverage/
.nyc_output/

# TypeScript cache
*.tsbuildinfo
tsconfig.tsbuildinfo

# Temporary files
tmp/
temp/
*.tmp
*.temp

# Debug
debug.log

# Credentials (never commit these)
*.pem
*.key
credentials.json
secrets.json
*.p12
*.pfx

# Rust
**/*.rs.bk

# Husky
.husky/_/
