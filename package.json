{
  "name": "clipy",
  "version": "2.0.2",
  "description": "Open-source YouTube video downloader and editor with native performance",
  "author": "BankkRoll <https://github.com/BankkRoll>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/BankkRoll/clipy"
  },
  "type": "module",
  "packageManager": "pnpm@10.13.1",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives --max-warnings 0",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\"",
    "typecheck": "tsc --noEmit && tsc -p e2e/tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "coverage:rust": "node scripts/coverage-rust.mjs",
    "coverage": "pnpm test:coverage && pnpm build && pnpm coverage:rust && node scripts/coverage-summary.mjs",
    "prepare": "husky",
    "e2e": "wdio run e2e/wdio.conf.ts"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-collapsible": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-progress": "^1.2.1",
    "@radix-ui/react-radio-group": "^1.5.1",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slider": "^1.6.1",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-toast": "^1.3.1",
    "@radix-ui/react-toggle": "^1.2.1",
    "@radix-ui/react-toggle-group": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/plugin-dialog": "^2.8.4",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-shell": "^2.6.0",
    "@tauri-apps/plugin-updater": "^2.14.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^0.577.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-resizable-panels": "2.1.9",
    "react-router-dom": "^7.18.5",
    "sonner": "^1.7.4",
    "tailwind-merge": "^2.6.1",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@tauri-apps/cli": "^2.12.4",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/mocha": "10.0.10",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@vitest/coverage-istanbul": "4.1.12",
    "@wdio/cli": "^9.32.0",
    "@wdio/globals": "^9.31.3",
    "@wdio/local-runner": "^9.32.0",
    "@wdio/mocha-framework": "^9.32.0",
    "@wdio/spec-reporter": "^9.32.0",
    "autoprefixer": "^10.6.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "17.13.0",
    "husky": "^9.1.7",
    "jsdom": "29.1.1",
    "lint-staged": "^15.5.2",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "^6.4.5",
    "vitest": "4.1.12",
    "webdriverio": "^9.32.0"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{css,json,md}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "overrides": {
      "vite": "^6.4.5",
      "serialize-javascript": "^7.1.2",
      "basic-ftp": "^6.2.1"
    }
  }
}
